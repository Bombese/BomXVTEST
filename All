local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Eclipse Mod HUB|All Map",
    SubTitle = "test version ",
    TabWidth = 160,
    Size = UDim2.fromOffset(450, 350),
    Acrylic = true,
    Theme = "VSC Dark High Contrast",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local MainTab = Window:AddTab({ Title = "Main", Icon = "home" })

local SelectedPlayer = nil

local Dropdown = MainTab:AddDropdown("PlayerDropdown", {
    Title = "Select Player",
    Values = {},
    Multi = false,
})

local function UpdatePlayerList()
    local list = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(list, player.Name)
        end
    end

    Dropdown:SetValues(list)

    if SelectedPlayer and not table.find(list, SelectedPlayer) then
        SelectedPlayer = nil
    end
end

Dropdown:OnChanged(function(value)
    SelectedPlayer = value
end)

MainTab:AddButton({
    Title = "Teleport",
    Callback = function()
        if SelectedPlayer then
            local target = Players:FindFirstChild(SelectedPlayer)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame =
                    target.Character.HumanoidRootPart.CFrame
            end
        else
            warn("ยังไม่ได้เลือกผู้เล่น")
        end
    end
})

MainTab:AddButton({
    Title = "Refresh",
    Callback = function()
        UpdatePlayerList()
    end
})

task.wait(1)
UpdatePlayerList()

Players.PlayerAdded:Connect(UpdatePlayerList)
Players.PlayerRemoving:Connect(UpdatePlayerList)

MainTab:AddSection("Noclip Inf Jump And ESP")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local ESPEnabled = false
local ESPContainer = {}

-- ฟังก์ชันสร้าง ESP
local function CreateESP(player)
    if player == LocalPlayer then return end

    local esp = {}

    -- Highlight สีฟ้า
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(0, 170, 255)
    highlight.OutlineColor = Color3.fromRGB(0, 170, 255)
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.Parent = game.CoreGui
    esp.Highlight = highlight

    -- BillboardGui (ตัวหนังสือ)
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 120, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.fromRGB(0, 255, 255)
    text.TextStrokeTransparency = 0.5
    text.TextScaled = false
    text.TextSize = 12 -- 🔹 ตัวเล็ก
    text.Font = Enum.Font.SourceSansBold
    text.Parent = billboard

    billboard.Parent = game.CoreGui

    esp.Billboard = billboard
    esp.Text = text

    ESPContainer[player] = esp
end

-- ลบ ESP
local function RemoveESP(player)
    if ESPContainer[player] then
        for _, v in pairs(ESPContainer[player]) do
            if v then v:Destroy() end
        end
        ESPContainer[player] = nil
    end
end

-- อัปเดต ESP
RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum then
                if not ESPContainer[player] then
                    CreateESP(player)
                end

                local esp = ESPContainer[player]

                -- ระยะ
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
                distance = math.floor(distance)

                -- อัปเดตข้อความ
                esp.Text.Text = player.Name .. " | " .. math.floor(hum.Health) .. "HP | " .. distance .. "m"

                -- ติดตามตัว
                esp.Billboard.Adornee = hrp
                esp.Highlight.Adornee = char
            end
        end
    end
end)

-- ปุ่มเปิด/ปิด ESP
MainTab:AddToggle("ESP_Toggle", {
    Title = "ESP Player",
    Default = false,
    Callback = function(state)
        ESPEnabled = state

        if not state then
            -- ปิด = ลบทั้งหมด
            for player, _ in pairs(ESPContainer) do
                RemoveESP(player)
            end
        end
    end
})

-- คนเข้า
Players.PlayerAdded:Connect(function(player)
    if ESPEnabled then
        CreateESP(player)
    end
end)

-- คนออก
Players.PlayerRemoving:Connect(function(player)
    RemoveESP(player)
end)

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local NoclipEnabled = false
local InfJumpEnabled = false

-- 🧱 NoClip (ทะลุกำแพง)
RunService.Stepped:Connect(function()
    if NoclipEnabled and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end
end)

-- 🦘 Infinite Jump
UserInputService.JumpRequest:Connect(function()
    if InfJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

-- 🔘 Toggle NoClip
MainTab:AddToggle("NoclipToggle", {
    Title = "NoClip",
    Default = false,
    Callback = function(state)
        NoclipEnabled = state
    end
})

-- 🔘 Toggle Infinite Jump
MainTab:AddToggle("InfJumpToggle", {
    Title = "Infinite Jump",
    Default = false,
    Callback = function(state)
        InfJumpEnabled = state
    end
})

if not NoclipEnabled and LocalPlayer.Character then
    for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = true
        end
    end
end

MainTab:AddSection("Settings Speed And Jump")

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local SpeedEnabled = false
local JumpEnabled = false

local SpeedValue = 16
local JumpValue = 50

local function ApplyStats()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = SpeedEnabled and SpeedValue or 16
            hum.JumpPower = JumpEnabled and JumpValue or 50
        end
    end
end

-- 2️⃣ Speed Slider
MainTab:AddSlider("SpeedSlider", {
    Title = "Speed",
    Default = 16,
    Min = 16,
    Max = 200,
    Rounding = 0,
    Callback = function(value)
        SpeedValue = value
        if SpeedEnabled then ApplyStats() end
    end
})

-- 1️⃣ Speed Toggle
MainTab:AddToggle("SpeedToggle", {
    Title = "Enable Speed",
    Default = false,
    Callback = function(state)
        SpeedEnabled = state
        ApplyStats()
    end
})

-- 4️⃣ Jump Slider
MainTab:AddSlider("JumpSlider", {
    Title = "Jump Power",
    Default = 50,
    Min = 50,
    Max = 200,
    Rounding = 0,
    Callback = function(value)
        JumpValue = value
        if JumpEnabled then ApplyStats() end
    end
})

-- 3️⃣ Jump Toggle
MainTab:AddToggle("JumpToggle", {
    Title = "Enable Jump",
    Default = false,
    Callback = function(state)
        JumpEnabled = state
        ApplyStats()
    end
})

-- รีสปอว์น
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    ApplyStats()
end)