RunService.RenderStepped:Connect(function()
    if not FollowEnabled then return end
    if not SelectedPlayer then return end

    local target = Players:FindFirstChild(SelectedPlayer)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

        local myHRP = myChar.HumanoidRootPart
        local hrp = target.Character.HumanoidRootPart

        local offset

        if TPMode == "Front" then
            offset = hrp.CFrame.LookVector * Distance
        elseif TPMode == "Behind" then
            offset = -hrp.CFrame.LookVector * Distance
        elseif TPMode == "Above" then
            offset = Vector3.new(0, Distance, 0)
        elseif TPMode == "Below" then
            offset = Vector3.new(0, -Distance, 0)
        end

        local targetPos = hrp.Position + offset

        -- 🔥 ลอยค้าง + ปรับความไว
        myHRP.CFrame = myHRP.CFrame:Lerp(CFrame.new(targetPos), FollowSpeed)
    end
end)

