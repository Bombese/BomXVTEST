local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Eclipse Mod HUB | murder mystery 2",
    SubTitle = "V1.00 ",
    TabWidth = 160,
    Size = UDim2.fromOffset(450, 350),
    Acrylic = true,
    Theme = "VSC Dark High Contrast",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- ==============================
-- 👁️ ESP TAB
-- ==============================
local ESPTab = Window:AddTab({ Title = "ESP", Icon = "eye" })

local ESPSheriff = false
local ESPMurder = false
local ESPGun = false

local Tracers = {}
local Billboards = {}
local GunTracer = nil
local Camera = workspace.CurrentCamera

-- ==============================
-- 🔍 ROLE
-- ==============================
local function getRole(player)
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character

    if backpack and backpack:FindFirstChild("Gun") then
        return "Sheriff"
    elseif backpack and backpack:FindFirstChild("Knife") then
        return "Murderer"
    end

    if char and char:FindFirstChild("Gun") then
        return "Sheriff"
    elseif char and char:FindFirstChild("Knife") then
        return "Murderer"
    end

    return "Innocent"
end

-- ==============================
-- 🌈 RGB
-- ==============================
local function getRGB()
    return Color3.fromHSV(tick()%5/5,1,1)
end

-- ==============================
-- 💡 HIGHLIGHT
-- ==============================
local function createHighlight(char, color)
    if char:FindFirstChild("ESP_HL") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_HL"
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.5
    hl.Parent = char
end

-- ==============================
-- 🏷️ NAME TAG
-- ==============================
local function createBillboard(player, text, color)
    local char = player.Character
    if not char or not char:FindFirstChild("Head") then return end

    if char:FindFirstChild("ESP_TAG") then
        char.ESP_TAG:Destroy()
    end

    local bill = Instance.new("BillboardGui", char)
    bill.Name = "ESP_TAG"
    bill.Size = UDim2.new(0,200,0,50)
    bill.Adornee = char.Head
    bill.AlwaysOnTop = true

    local txt = Instance.new("TextLabel", bill)
    txt.Size = UDim2.new(1,0,1,0)
    txt.BackgroundTransparency = 1
    txt.Text = text
    txt.TextColor3 = color
    txt.TextStrokeTransparency = 0
    txt.TextScaled = true
end

-- ==============================
-- 📏 TRACER
-- ==============================
local function createTracer(player, color)
    if Tracers[player] then return end

    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Color = color
    line.Transparency = 1

    Tracers[player] = line
end

local function removeTracer(player)
    if Tracers[player] then
        Tracers[player]:Remove()
        Tracers[player] = nil
    end
end

-- ==============================
-- 🔫 GUN
-- ==============================
local function getGun()
    local g = workspace:FindFirstChild("GunDrop")
    if g and g:IsA("BasePart") then return g end
    if g and g:FindFirstChild("Gun") then return g.Gun end
end

-- ==============================
-- 🔘 TOGGLES
-- ==============================
ESPTab:AddToggle("SheriffESP", {
    Title = "Sheriff",
    Callback = function(v) ESPSheriff = v end
})

ESPTab:AddToggle("MurderESP", {
    Title = "Murderer",
    Callback = function(v) ESPMurder = v end
})

ESPTab:AddToggle("GunESP", {
    Title = "Gun RGB",
    Callback = function(v) ESPGun = v end
})

-- ==============================
-- 🔁 LOOP
-- ==============================
task.spawn(function()
    while task.wait() do
        pcall(function()

            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)

            for _, player in pairs(game.Players:GetPlayers()) do
                if player ~= game.Players.LocalPlayer then

                    local role = getRole(player)
                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")

                    if root then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

                        -- 🔵 Sheriff
                        if ESPSheriff and role == "Sheriff" then
                            createTracer(player, Color3.fromRGB(0,170,255))
                            createHighlight(char, Color3.fromRGB(0,170,255))
                            createBillboard(player, player.Name.." [Sheriff]", Color3.fromRGB(0,170,255))

                        -- 🔴 Murder
                        elseif ESPMurder and role == "Murderer" then
                            createTracer(player, Color3.fromRGB(255,0,0))
                            createHighlight(char, Color3.fromRGB(255,0,0))
                            createBillboard(player, player.Name.." [Murder]", Color3.fromRGB(255,0,0))

                        else
                            removeTracer(player)
                        end

                        local line = Tracers[player]
                        if line and onScreen then
                            line.From = center
                            line.To = Vector2.new(pos.X, pos.Y)
                            line.Visible = true
                        elseif line then
                            line.Visible = false
                        end
                    end
                end
            end

            -- 🔫 GUN RGB
            if ESPGun then
                local gun = getGun()
                if gun then
                    local pos, onScreen = Camera:WorldToViewportPoint(gun.Position)

                    if not GunTracer then
                        GunTracer = Drawing.new("Line")
                        GunTracer.Thickness = 3
                    end

                    if onScreen then
                        GunTracer.From = center
                        GunTracer.To = Vector2.new(pos.X, pos.Y)
                        GunTracer.Color = getRGB()
                        GunTracer.Visible = true
                    else
                        GunTracer.Visible = false
                    end
                end
            end

        end)
    end
end)