FarmTab:AddToggle("AutoFarmCoins", {
    Title = "Auto Farm Coins",
    Default = false,
    Callback = function(Value)
        _G.AutoFarm = Value
        
        if Value then
            task.spawn(function()
                local isFirstTime = true
                while _G.AutoFarm do
                    if not isInLobby() then
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        if root then
                            local target = findNextCoin()
                            if target then
                                setHorizontalFloat(root)
                                CollectedCoins[target] = true
                                local targetCFrame = target.CFrame + HEIGHT_OFFSET
                                
                                if isFirstTime then
                                    root.CFrame = targetCFrame
                                    task.wait(FIRST_WAIT)
                                    isFirstTime = false
                                else
                                    local d = (root.Position - target.Position).Magnitude
                                    local tween = TweenService:Create(root, TweenInfo.new(d/FLOAT_SPEED, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
                                    tween:Play()
                                    tween.Completed:Wait()
                                    task.wait(HOLD_TIME)
                                end
                            else 
                                -- ถ้าไม่มีเหรียญในระยะ 1500m ให้ล้างค่าฟิสิกส์ชั่วคราว
                                if root:FindFirstChild("StableVelocity") then root.StableVelocity:Destroy() end
                                task.wait(1) 
                            end
                        else task.wait(1) end
                    else
                        resetPhysics()
                        isFirstTime = true
                        task.wait(2)
                    end
                end
            end)
        else
            resetPhysics()
        end
    end
})

