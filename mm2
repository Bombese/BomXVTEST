local function isInLobby()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return true end

    local spawnPoint = workspace:FindFirstChildOfClass("SpawnLocation")
    if spawnPoint then
        local dist = (root.Position - spawnPoint.Position).Magnitude
        if dist < LOBBY_DISTANCE then return true end
    end
    return false
end

-- [[ 5. ฟังก์ชันช่วยเหลือ ]]
local function resetPhysics()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if root then
        if root:FindFirstChild("StableVelocity") then root.StableVelocity:Destroy() end
        if root:FindFirstChild("StableGyro") then root.StableGyro:Destroy() end
    end
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait(0.1)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end
end

