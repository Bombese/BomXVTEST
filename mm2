-- [[ 4. ฟังก์ชันหา "มีด" และถืออัตโนมัติ ]]
local function equipKnife()
    local char = LocalPlayer.Character
    if not char then return nil end

    -- 1. เช็คว่าถืออยู่ในมือหรือยัง (หา Tool ที่มีคำว่า Knife หรือตามชื่อที่เกมกำหนด)
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool and (tool.Name:lower():find("knife") or tool.Name:lower():find("sword")) then
        return tool
    end

    -- 2. ถ้าไม่ได้ถือ ให้หาใน Backpack
    local backpackTool = LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
    if backpackTool and (backpackTool.Name:lower():find("knife") or backpackTool.Name:lower():find("sword")) then
        hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:EquipTool(backpackTool) -- ถือมีดอัตโนมัติ
            return backpackTool
        end
    end

    return nil -- ไม่มีมีดในตัว
end

-- [[ 5. ฟังก์ชันรีเซ็ตฟิสิกส์ ]]
local function resetPhysics()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        if root:FindFirstChild("KillVelocity") then root.KillVelocity:Destroy() end
        if root:FindFirstChild("KillGyro") then root.KillGyro:Destroy() end
    end
end

