KillTab:AddToggle("AutoKillMurder", {
    Title = "Kill Murderer BETA",
    Default = false,
    Callback = function(Value)
        _G.AutoShootMurder = Value
        
        if Value then
            task.spawn(function()
                while _G.AutoShootMurder do
                    local gun = equipGun()
                    local murdererChar = findMurderer()
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

                    if gun and murdererChar and myRoot then
                        local mRoot = murdererChar:FindFirstChild("HumanoidRootPart")
                        local mHum = murdererChar:FindFirstChildOfClass("Humanoid")

                        if mRoot and mHum and mHum.Health > 0 then
                            local dist = (myRoot.Position - mRoot.Position).Magnitude
                            
                            if dist <= SHOOT_DISTANCE then
                                -- ระบบเคลื่อนที่ (BodyVelocity)
                                local bv = myRoot:FindFirstChild("ShootVelocity") or Instance.new("BodyVelocity")
                                bv.Name = "ShootVelocity"
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Velocity = Vector3.new(0, 0, 0)
                                bv.Parent = myRoot

                                -- ลอยเหนือหัวฆาตกรเพื่อความปลอดภัย
                                local targetPos = mRoot.Position + Vector3.new(0, TARGET_HEIGHT, 0)
                                myRoot.CFrame = CFrame.new(myRoot.Position, mRoot.Position)
                                myRoot.CFrame = myRoot.CFrame:Lerp(CFrame.new(targetPos, mRoot.Position), 0.15)
                                
                                -- สั่งยิง (ทำงานร่วมกับ Silent Aim ด้านบน)
                                gun:Activate()
                            end
                        else
                            stopFlying()
                        end
                    else
                        stopFlying()
                    end
                    task.wait(0.05) -- หน่วงเวลาเล็กน้อยกันกระตุกและกันหลุด
                end
                stopFlying()
            end)
        else
