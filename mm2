-- 🔁 LOOP
-- ==============================
task.spawn(function()
    while task.wait() do
        pcall(function()

            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)

            -- 👤 PLAYER ESP
            for _, player in pairs(game.Players:GetPlayers()) do
                if player ~= game.Players.LocalPlayer then

                    local role = getRole(player)
                    local char = player.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")

                    if root then
                        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

                        if ESPSheriff and role == "Sheriff" then
                            createTracer(player, Color3.fromRGB(0,170,255))
                            createHighlight(char, Color3.fromRGB(0,170,255))
                            createBillboard(player, player.Name.." [Sheriff]", Color3.fromRGB(0,170,255))

                        elseif ESPMurder and role == "Murderer" then
                            createTracer(player, Color3.fromRGB(255,0,0))
                            createHighlight(char, Color3.fromRGB(255,0,0))
                            createBillboard(player, player.Name.." [Murder]", Color3.fromRGB(255,0,0))

                        elseif ESPInnocent and role == "Innocent" then
                            createTracer(player, Color3.fromRGB(255,255,255))
                            createHighlight(char, Color3.fromRGB(255,255,255))
                            createBillboard(player, player.Name.." [Innocent]", Color3.fromRGB(255,255,255))

                        else
                            removeTracer(player)

                            if char and char:FindFirstChild("ESP_HL") then
                                char.ESP_HL:Destroy()
                            end

                            if char and char:FindFirstChild("ESP_TAG") then
                                char.ESP_TAG:Destroy()
                            end
                        end

                        local line = Tracers[player]
                        if line and onScreen then
                            line.From = center
                            line.To = Vector2.new(pos.X, pos.Y)
                            line.Visible = true
                        elseif line then
                            line.Visible = false
                        end
                    end
                end
            end

            -- 🔫 GUN ESP
            if ESPGun then
                local gun = getGun()

                if gun and gun:IsA("BasePart") then
                    if not GunSpawned then
                        GunSpawned = true
                        game.StarterGui:SetCore("SendNotification", {
                            Title = "🔫 Gun Spawned!",
                            Text = "ปืนตกแล้ว 💀",
                            Duration = 5
                        })
                    end

                    local pos, onScreen = Camera:WorldToViewportPoint(gun.Position)

                    if not GunTracer then
                        GunTracer = Drawing.new("Line")
                        GunTracer.Thickness = 3
                    end

                    if onScreen then
                        GunTracer.From = center
                        GunTracer.To = Vector2.new(pos.X, pos.Y)
                        GunTracer.Color = getRGB()
                        GunTracer.Visible = true
                    else
                        GunTracer.Visible = false
                    end

                    -- Highlight Gun
                    if not gun.Parent:FindFirstChild("ESP_GUN") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "ESP_GUN"
                        hl.FillColor = Color3.fromRGB(255,255,0)
                        hl.OutlineColor = Color3.fromRGB(255,255,0)
                        hl.FillTransparency = 0.3
                        hl.Parent = gun.Parent
                    end

                else
                    GunSpawned = false
                    if GunTracer then
                        GunTracer.Visible = false
                    end
                end
            end

        end)
    end
end)