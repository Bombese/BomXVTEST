                    -- Highlight Gun
                    if not gun.Parent:FindFirstChild("ESP_GUN") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "ESP_GUN"
                        hl.FillColor = Color3.fromRGB(255,255,0)
