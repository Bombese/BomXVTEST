-- [[ 2. ระบบ Silent Aim (ล็อคเป้ากระสุน) ]]
-- ส่วนนี้จะทำให้ปืนยิงตรงตัวฆาตกรเสมอแม้เราจะไม่ได้หันเมาส์ไปหา
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__index = newcclosure(function(self, index)
    if _G.AutoShootMurder and not checkcaller() and self == Mouse then
        local murdererChar = nil
        -- หาฆาตกร (ใช้ Logic เดียวกับฟังก์ชัน findMurderer)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local knife = p.Character:FindFirstChildWhichIsA("Tool")
                if knife and (knife.Name:lower():find("knife") or knife.Name:lower():find("blade")) then
                    murdererChar = p.Character
                    break
                end
            end
        end

        if murdererChar and murdererChar:FindFirstChild("HumanoidRootPart") then
            if index == "Hit" then
                return murdererChar.HumanoidRootPart.CFrame
            elseif index == "Target" then
                return murdererChar.HumanoidRootPart
            end
        end
    end
    return oldIndex(self, index)
end)
setreadonly(mt, true)

-- [[ 4. ตั้งค่าการทำงาน ]]
_G.AutoShootMurder = false
local SHOOT_DISTANCE = 2000 -- เพิ่มระยะเล็กน้อย
local TARGET_HEIGHT = 8      -- ความสูงที่ลอยเหนือฆาตกร

-- [[ 5. ฟังก์ชันสนับสนุน ]]
local function equipGun()
    local char = LocalPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool and (tool.Name:lower():find("gun") or tool.Name:lower():find("revolver")) then
        return tool
    end
    local backpackTool = LocalPlayer.Backpack:FindFirstChildWhichIsA("Tool")
    if backpackTool and (backpackTool.Name:lower():find("gun") or backpackTool.Name:lower():find("revolver")) then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:EquipTool(backpackTool)
            return backpackTool
        end
    end
    return nil
end

local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local knife = p.Character:FindFirstChildWhichIsA("Tool")
            if knife and (knife.Name:lower():find("knife") or knife.Name:lower():find("blade")) then
                return p.Character
            end
        end
    end
    return nil
end

local function stopFlying()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        if root:FindFirstChild("ShootVelocity") then root.ShootVelocity:Destroy() end
        if root:FindFirstChild("ShootGyro") then root.ShootGyro:Destroy() end
    end
end

