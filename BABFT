local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Eclipse Mod HUB | Build A Boat For Treasure",
    SubTitle = "Version Apha 0.1",
    TabWidth = 160,
    Size = UDim2.fromOffset(450, 350),
    Acrylic = true,
    Theme = "VSC Dark High Contrast",
    MinimizeKey = Enum.KeyCode.LeftControl
})
-- ==============================
-- 📦 MAIN TAB
-- ==============================
local MainTab = Window:AddTab({ Title = "Main", Icon = "home" })

local AutoFarmGold = false
local Speed = 150

local RunService = game:GetService("RunService")

-- ==============================
-- 🧍 GET CHAR
-- ==============================
local function getHRP()
    local char = game.Players.LocalPlayer.Character or game.Players.LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

-- ==============================
-- ✈️ LOCK FLY MOVE (ไม่ตกน้ำ)
-- ==============================
local function flyTo(cf)
    local hrp = getHRP()

    -- ล็อคสูงไว้กันตก
    local targetY = cf.Y + 10

    while AutoFarmGold and (hrp.Position - cf.Position).Magnitude > 5 do
        local pos = hrp.Position
        local target = Vector3.new(cf.X, targetY, cf.Z)

        local dir = (target - pos).Unit
        hrp.Velocity = Vector3.zero -- กันตก

        hrp.CFrame = CFrame.new(pos + dir * Speed * RunService.Heartbeat:Wait())

        -- ล็อคความสูงตลอด
        hrp.CFrame = CFrame.new(hrp.Position.X, targetY, hrp.Position.Z)
    end

    if AutoFarmGold then
        hrp.CFrame = CFrame.new(cf.X, targetY, cf.Z)
    end
end

-- ==============================
-- 🎚️ UI
-- ==============================
MainTab:AddToggle("AutoFarmGold", {
    Title = "Auto Farm Gold",
    Default = false,
    Callback = function(v)
        AutoFarmGold = v
    end
})

MainTab:AddSlider("Speed", {
    Title = "Speed",
    Default = 150,
    Min = 50,
    Max = 500,
    Rounding = 0,
    Callback = function(v)
        Speed = v
    end
})

-- ==============================
-- 📍 จุดฟาร์ม
-- ==============================
local P1 = CFrame.new(-42.61, 17.51, 256.25)
local P2 = CFrame.new(-59.82, 61.90, 8530)
local P3 = CFrame.new(-57.85, -353.76, 9486.17)

-- ==============================
-- 🔁 LOOP
-- ==============================
task.spawn(function()
    while task.wait() do
        if AutoFarmGold then
            pcall(function()

                flyTo(P1)
                if not AutoFarmGold then return end

                flyTo(P2)
                if not AutoFarmGold then return end

                flyTo(P3)
                if not AutoFarmGold then return end

                task.wait(5) -- ⏱️ รอ 5 วิ

            end)
        end
    end
end)