local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Eclipse Mod HUB | Build A Boat For Treasure",
    SubTitle = "Version XXX",
    TabWidth = 160,
    Size = UDim2.fromOffset(450, 350),
    Acrylic = true,
    Theme = "VSC Dark High Contrast",
    MinimizeKey = Enum.KeyCode.LeftControl
})
-- ==============================
-- 📦 MAIN TAB
-- ==============================
local MainTab = Window:AddTab({ Title = "Main", Icon = "home" })

local AutoFarmGold = false
local Speed = 120

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local BV, BG, NoclipConn

-- ==============================
-- 🧍 GET CHAR
-- ==============================
local function getChar()
    local plr = Players.LocalPlayer
    return plr.Character or plr.CharacterAdded:Wait()
end

-- ==============================
-- 🧱 NOCLIP
-- ==============================
local function startNoclip()
    NoclipConn = RunService.Stepped:Connect(function()
        for _, v in pairs(getChar():GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end)
end

local function stopNoclip()
    if NoclipConn then
        NoclipConn:Disconnect()
        NoclipConn = nil
    end
end

-- ==============================
-- ✈️ FLY
-- ==============================
local function startFly()
    local char = getChar()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")

    hum.PlatformStand = true

    BV = Instance.new("BodyVelocity")
    BV.MaxForce = Vector3.new(1e9,1e9,1e9)
    BV.Parent = hrp

    BG = Instance.new("BodyGyro")
    BG.MaxTorque = Vector3.new(1e9,1e9,1e9)
    BG.Parent = hrp
end

local function stopFly()
    local char = getChar()
    local hum = char:FindFirstChild("Humanoid")

    if hum then hum.PlatformStand = false end
    if BV then BV:Destroy() BV = nil end
    if BG then BG:Destroy() BG = nil end
end

-- ==============================
-- 🚀 MOVE
-- ==============================
local function moveTo(cf)
    local hrp = getChar():WaitForChild("HumanoidRootPart")

    repeat
        if not AutoFarmGold then break end

        local dir = (cf.Position - hrp.Position)
        if dir.Magnitude < 5 then break end

        BV.Velocity = dir.Unit * Speed
        BG.CFrame = CFrame.new(hrp.Position, cf.Position)

        RunService.Heartbeat:Wait()
    until false

    if BV then
        BV.Velocity = Vector3.zero
    end
end

-- ==============================
-- 🎚️ UI
-- ==============================
MainTab:AddToggle("AutoFarmGold", {
    Title = "Auto Farm Gold",
    Default = false,
    Callback = function(v)
        AutoFarmGold = v

        if v then
            startFly()
            startNoclip()
        else
            stopFly()
            stopNoclip()
        end
    end
})

MainTab:AddSlider("Speed", {
    Title = "Speed",
    Default = 120,
    Min = 50,
    Max = 300,
    Rounding = 0,
    Callback = function(v)
        Speed = v
    end
})

