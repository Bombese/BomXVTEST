-- =========================
-- Infinite Slide FUNCTION
-- =========================

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer

local enabled = false
local slideFriction = -8
local cachedTables = {}
local plrModel
local connection

local keys = {
    "Friction","AirStrafeAcceleration","JumpHeight","RunDeaccel",
    "JumpSpeedMultiplier","JumpCap","SprintCap","WalkSpeedMultiplier",
    "BhopEnabled","Speed","AirAcceleration","RunAccel","SprintAcceleration"
}

local function hasAll(tbl)
    if type(tbl) ~= "table" then return false end
    for _, k in ipairs(keys) do
        if rawget(tbl, k) == nil then
            return false
        end
    end
    return true
end

local function setFriction(v)
    for _, t in ipairs(cachedTables) do
        pcall(function()
            t.Friction = v
        end)
    end
end

local function updateModel()
    local folder = workspace:FindFirstChild("Game")
        and workspace.Game:FindFirstChild("Players")

    plrModel = folder and folder:FindFirstChild(player.Name)
end

local function loop()
    if not plrModel then
        setFriction(5)
        return
    end

    local state = plrModel:GetAttribute("State")

    if state == "Slide" then
        plrModel:SetAttribute("State", "EmotingSlide")
    elseif state == "EmotingSlide" then
        setFriction(slideFriction)
    else
        setFriction(5)
    end
end

local function startSlide()
    if connection then return end

    cachedTables = {}

    for _, obj in ipairs(getgc(true)) do
        local ok, res = pcall(function()
            if hasAll(obj) then return obj end
        end)

        if ok and res then
            table.insert(cachedTables, res)
        end
    end

    updateModel()

    connection = RunService.Heartbeat:Connect(loop)

    player.CharacterAdded:Connect(function()
        task.wait(0.1)
        updateModel()
    end)
end

local function stopSlide()
    if connection then
        connection:Disconnect()
        connection = nil
    end

    setFriction(5)
    cachedTables = {}
    plrModel = nil
end

function ToggleInfiniteSlide()
    enabled = not enabled

    if enabled then
        startSlide()
    else
        stopSlide()
    end
end

