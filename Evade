                                    end
                                end
                            end
                        else
                            -- ถ้าไม่ล้ม ลบ ESP
                            local char = plr.Character
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local esp = hrp:FindFirstChild("DownedESP")
                                if esp then esp:Destroy() end
                            end
                        end
                    end
                end

                task.wait(0.5)
            end
        end)
    end
